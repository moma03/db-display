# Database credentials for led_renderer.
#
# Copy to ".env" next to this file (or at the repo root) and fill in. The
# renderer refuses to read these from renderer.json -- a file called .env is
# recognised as sensitive by git, backup and deploy tooling, and by anyone who
# happens to look at the directory. A "config.json" is not.
#
# Key names match timetable-fetcher/.env so one file can serve both.
#
#   chmod 600 .env
#
# Precedence: real environment variables win over this file, so systemd's
# EnvironmentFile= and a one-off `DB_PG_HOST=... ./led_renderer` both work.
#
# Searched, in order, unless env_file / --env names one:
#   $LED_ENV_FILE, then config/.env, then <repo>/.env

DB_PG_HOST=10.0.10.132
DB_PG_PORT=5442
DB_PG_DBNAME=timetable_stops_db
DB_PG_USER=__YOUR_DB_USER__
DB_PG_PASSWORD=__YOUR_DB_PASSWORD__

# Optional: station EVA. Normally comes from renderer.json or --eva
# (the hub passes it per subprogram), so leave this unset.
#DB_EVA=8000297
