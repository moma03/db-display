// driver.json -- read once at startup. Restart the driver to change anything.
//
// rpi-rgb-led-matrix's own --led-* flags override the "matrix" block on top of
// this, so the LED_Panel_Controller hub keeps working the way it does today.
// The driver reads the EFFECTIVE values back after flag parsing, so a hub
// launching with --led-pwm-bits=5 also retargets the gamma LUT and dither.
//
// Defaults below are the current hardware: Pi 3B+, Electrodragon active-3
// adapter, 2 chains of 2x 128x64 panels = 256x128.
{
  "shm": {
    "path": "/led-frames",
    // Three, not two: the driver quantises straight out of the mapped slot
    // without copying, so a slot stays live for a whole pass. See frame_shm.h.
    "slot_count": 3
  },

  "matrix": {
    "rows": 64,
    "cols": 128,
    "chain_length": 2,
    "parallel": 2,
    "multiplexing": 0,
    "pwm_bits": 5,
    "pwm_lsb_nanoseconds": 130,
    // Shifts the library's bitplane timing table down by this many stops,
    // halving every plane's duration per step. NOT the temporal dithering
    // below. Raising it buys refresh rate but costs brightness, because
    // brightness = (on-time per frame) x (frames per second) and this halves
    // the first term. Measured at pwm_bits=4: 0 -> 125.7 Hz, 1 -> 239 Hz.
    "pwm_dither_bits": 1,
    "gpio_slowdown": 2,
    // MUST be about 0.79x the UNCAPPED median, or the limiter stops engaging
    // and the frame period wanders -- which is seen as brightness pulsing, not
    // as a rate change. Measured on this panel (2 chains x 2 panels,
    // slowdown=2), tuned against the real display:
    //
    //   pwm=5 dither=1  uncapped 216 Hz  ->  cap 170  ratio 0.79  ROCK SOLID
    //   pwm=4 dither=1  uncapped 239 Hz  ->  cap 190  ratio 0.79  stable
    //   pwm=6 dither=2  uncapped 295 Hz  ->  cap 220  ratio 0.75  stable
    //   pwm=6 dither=1  uncapped 197 Hz  ->  cap 180  ratio 0.91  PULSES
    //   pwm=6 dither=2  uncapped 295 Hz  ->  cap 280  ratio 0.95  FLICKERS
    //
    // At this setting the measured rate is median 170.0, p1 170.0, min 169.9 --
    // the headroom is wide enough that even interrupt-stalled frames still fit
    // inside the period, so the limiter absorbs all of the jitter. Every other
    // configuration tested had a min between 56 and 89 Hz.
    "limit_refresh_rate_hz": 170,
    // Leave OFF in production. The library printf()s the rate from inside its
    // SCHED_FIFO 99 GPIO thread on every single refresh -- that is the stdio
    // lock ~190 times a second on the one thread that must not be delayed.
    "show_refresh_rate": false,
    "hardware_mapping": "regular",
    "led_rgb_sequence": "RGB"
  },

  "gamma": {
    // Applied HERE, in the driver. The library's own CIE1931 correction is
    // switched off so the curve is applied exactly once. See src/common/gamma.h.
    "mode": "cie1931",          // cie1931 | power | linear
    "exponent": 2.2,            // only used by "power"
    "brightness_percent": 100   // folded into the LUT, before quantisation
  },

  "dither": {
    // OFF at this setting, deliberately. Two reasons, both measured:
    //
    //  1. At pwm_bits=5 the black clamp is 53 rather than 78, so far less is
    //     lost to truncation and the dither has much less to recover.
    //  2. The per-vsync quantise pass costs ~16% of the refresh rate, which
    //     would drop the uncapped median from 216 to ~182 and push the cap
    //     ratio from 0.79 to 0.93 -- straight into the pulsing regime above.
    //
    // It also caused a visible artefact here: the scrollbar track (#3C3C3C =
    // grey 60) sits below the pwm_bits=4 clamp, so it could only be shown by
    // alternating level 0/1, which read as flicker on that flat area. At
    // pwm_bits=5 grey 60 is a real level and the problem disappears.
    //
    // Turn it back on if you drop to pwm_bits=4, where it earns its cost.
    "enabled": false,
    "phases": 4,             // must divide 16: 1, 2, 4, 8 or 16
    // Frames per dither step, as a fraction of the panel refresh rate. 1 means
    // a full quantise pass every refresh (~190/s) which is the best quality
    // and the highest CPU cost; raise it if the driver cannot keep up.
    "swap_every_n_vsync": 1
  },

  "realtime": {
    "sched_fifo_priority": 80,
    // -1 = do not pin. This is deliberate: the library already pins its own
    // GPIO thread to core 3 at SCHED_FIFO 99, and with isolcpus=3 we are
    // already kept off it. Setting this to 3 puts the quantise pass in
    // competition with the bit-banger. The driver warns if you do.
    "cpu_affinity": -1,
    "lock_memory": true,
    "drop_privileges": true
  },

  "diagnostics": {
    // Seconds between swap-rate reports on a low-priority thread. 0 = off.
    "stats_interval_s": 0
  }
}
