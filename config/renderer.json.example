// renderer.json -- read once at startup. Restart the renderer to change it.
// (Layout lives in layout.json and IS hot-reloadable.)
//
// NO CREDENTIALS HERE. Database host, port, name, user and password come from
// a .env file -- see .env.example. The renderer rejects this file outright if
// it finds any of them, rather than quietly reading a secret from a path that
// nothing treats as sensitive.
{
  "shm": {
    // Must match driver.json. The DRIVER creates this segment, because it is
    // the one that knows the authoritative panel geometry; the renderer waits
    // for it and adapts.
    "path": "/led-frames"
  },

  // Where the layout lives. Relative paths resolve against THIS file, so the
  // renderer works from any working directory (systemd gives it /).
  "layout": "layout.json",

  // Optional. Unset means: $LED_ENV_FILE, then ./.env, then ../.env.
  // "env_file": ".env",

  // Nothing on this board moves faster than ~40 px/s, so 30 is imperceptible
  // from 60 and leaves the CPU alone. The driver re-quantises at the panel
  // refresh rate regardless, so this is not the dither rate.
  "target_fps": 30,

  // Seconds to wait for the driver's shared-memory segment before giving up.
  "wait_for_shm_s": 30,

  "departures": {
    // A train leaves the board this long after its effective (delayed, else
    // planned) time -- checked every frame, not only when data is fetched.
    // DB times are whole minutes, so 60 means: shown throughout its departure
    // minute, gone at the start of the next. Raise it if trains vanish while
    // still at the platform because the delay forecast was too optimistic.
    "grace_seconds": 60,
    // Delays and platform changes are shown in place at once, and a departed
    // hero is replaced without touching the list. Everything else (new trains,
    // new reasons, reordering) waits until the list has paged back to the
    // top, so the board never jumps mid-scroll. This caps that wait.
    "max_defer_seconds": 60
  },

  "database": {
    // Non-secret behaviour only. The hub overrides eva per subprogram
    // via --eva, so this is just the standalone default.
    "eva": 8000297,
    // The renderer keeps one connection open and re-queries when the
    // timetable-fetcher announces new data for this station (NOTIFY). This
    // timer is only the fallback for a lost notification or an older fetcher.
    "refresh_seconds": 120,
    // The display renews its row in the fetcher's display_subscriptions table
    // this often. While the row is fresh the fetcher polls this station fast,
    // and fetches it at all if it is not in the fetcher's own station list.
    // Keep it well below the fetcher's subscription_ttl_seconds (120).
    "heartbeat_seconds": 30
    // Optional. Names this panel in display_subscriptions; one row per id.
    // Unset = "<hostname>:<shm path>". The hub can also pass --display-id.
    // "display_id": "hallway"
  }
}
