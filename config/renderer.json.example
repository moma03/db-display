// renderer.json -- read once at startup. Restart the renderer to change it.
// (Layout lives in layout.json and IS hot-reloadable.)
//
// NO CREDENTIALS HERE. Database host, port, name, user and password come from
// a .env file -- see .env.example. The renderer rejects this file outright if
// it finds any of them, rather than quietly reading a secret from a path that
// nothing treats as sensitive.
{
  "shm": {
    // Must match driver.json. The DRIVER creates this segment, because it is
    // the one that knows the authoritative panel geometry; the renderer waits
    // for it and adapts.
    "path": "/led-frames"
  },

  // Where the layout lives. Relative paths resolve against THIS file, so the
  // renderer works from any working directory (systemd gives it /).
  "layout": "layout.json",

  // Optional. Unset means: $LED_ENV_FILE, then ./.env, then ../.env.
  // "env_file": ".env",

  // Nothing on this board moves faster than ~40 px/s, so 30 is imperceptible
  // from 60 and leaves the CPU alone. The driver re-quantises at the panel
  // refresh rate regardless, so this is not the dither rate.
  "target_fps": 30,

  // Seconds to wait for the driver's shared-memory segment before giving up.
  "wait_for_shm_s": 30,

  "database": {
    // Non-secret behaviour only. The hub overrides eva per subprogram
    // via --eva, so this is just the standalone default.
    "eva": 8000297,
    "refresh_seconds": 30
  }
}
